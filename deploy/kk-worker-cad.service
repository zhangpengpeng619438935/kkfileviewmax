[Unit]
Description=kkfileview preview worker (cad DWG 矢量)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=kkfileview
WorkingDirectory=/opt/kkfileview-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/kkfileview-service/tools/step_worker.py --stage cad --daemon
Restart=always
RestartSec=3
# 日志：journalctl -u kk-worker-<stage> -f；同时留一份在 /var/log/kkfileview
StandardOutput=append:/var/log/kkfileview/worker.log
StandardError=append:/var/log/kkfileview/worker.log

[Install]
WantedBy=multi-user.target
