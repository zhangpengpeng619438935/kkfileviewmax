# kkFileView 4.4.0 引擎镜像：Ubuntu 22.04 + JDK8 + 外挂 LibreOffice 26.8
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    TZ=Asia/Shanghai

RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.aliyun.com@g; s@//security.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        fontconfig fonts-wqy-zenhei fonts-wqy-microhei \
        libxext6 libxrender1 libsm6 libice6 libxinerama1 libcups2 libdbus-1-3 \
        libglib2.0-0 libnss3 libxslt1.1 libcairo2 libpango-1.0-0 libfreetype6 \
        libjpeg-turbo8 libpng16-16 libxml2 libx11-6 libxcb1 libxau6 libxdmcp6 \
        libbsd0 libexpat1 zlib1g libcurl4 libharfbuzz0b \
        procps wget ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=kkfileview-custom:4.1.0 /usr/local/jdk1.8.0_251 /usr/local/jdk1.8.0_251
ENV JAVA_HOME=/usr/local/jdk1.8.0_251 \
    PATH=/usr/local/jdk1.8.0_251/bin:$PATH

COPY --from=kkfileview-custom:4.1.0 /usr/share/fonts /usr/share/fonts
COPY app440 /opt/kkFileView-4.4.0

# LibreOffice 26.8.1 运行时挂载点（compose 挂进来）
ENV KK_OFFICE_HOME=/opt/libreoffice26.8
# 4.4.0 的 ConfigUtils 用它定位 config/application.properties；
# 不设置会退到 <cwd>/server/src/main，读不到 office.home，启动直接报“找不到office组件”
ENV KKFILEVIEW_BIN_FOLDER=/opt/kkFileView-4.4.0/bin

RUN fc-cache -f >/dev/null 2>&1 || true

WORKDIR /opt/kkFileView-4.4.0
EXPOSE 8012

CMD ["java", "-Dfile.encoding=UTF-8", "-Dspring.config.location=/opt/kkFileView-4.4.0/config/application.properties", "-jar", "/opt/kkFileView-4.4.0/bin/kkFileView-4.4.0.jar"]
