# kkFileView 引擎镜像 v2：Ubuntu 22.04 + 外挂新版 LibreOffice
#
# 为什么要重建：
#   原镜像基于 Ubuntu 20.04（glibc 2.31），内置 LibreOffice 7.3.7。
#   7.3 遇到"页数多 + SmartArt 多"的 PPT 会直接 SIGABRT 崩溃。
#   LibreOffice 24.x/26.x 要求 glibc >= 2.34，20.04 装不了，所以换 22.04（glibc 2.35）。
#
# 设计要点：
#   - JDK 8、kkFileView 程序、中文字体全部从原镜像 COPY --from 复用，不需要重新部署
#   - 新版 LibreOffice 不打进镜像，而是 compose 挂载到 /opt/libreoffice26.8，
#     通过 KK_OFFICE_HOME 指向它；出问题去掉环境变量即可回滚到内置 7.3
#
# 构建：docker build -f engine/Dockerfile.v2 -t kkfileview-custom:22.04 .
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    TZ=Asia/Shanghai

# LibreOffice 运行时依赖：装 libreoffice-core 一并带齐(它自己会用 7.3 那套),
# 这样外挂的 26.8 版本不管缺哪个 .so 都有兜底。
RUN sed -i 's@//.*archive.ubuntu.com@//mirrors.aliyun.com@g; s@//security.ubuntu.com@//mirrors.aliyun.com@g' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-core \
        fonts-wqy-zenhei fonts-wqy-microhei fonts-noto-cjk \
        fontconfig libxext6 libxrender1 libsm6 libice6 libxinerama1 \
        libcups2 libdbus-1-3 libglib2.0-0 libnss3 libxslt1.1 \
        libcairo2 libpango-1.0-0 libfreetype6 \
        procps wget ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

# JDK 8：直接从原镜像搬(JDK 是自包含的，22.04 上照常跑)
COPY --from=kkfileview-custom:4.1.0 /usr/local/jdk1.8.0_251 /usr/local/jdk1.8.0_251
ENV JAVA_HOME=/usr/local/jdk1.8.0_251 \
    PATH=/usr/local/jdk1.8.0_251/bin:$PATH

# kkFileView 程序本体与原有中文字体
COPY --from=kkfileview-custom:4.1.0 /opt/kkFileView-4.1.0 /opt/kkFileView-4.1.0
COPY --from=kkfileview-custom:4.1.0 /usr/share/fonts /usr/share/fonts

# 新版 LibreOffice 的挂载点(compose 挂进来)，默认指向它；
# 若改回 default 则使用 apt 装的 LibreOffice 7.3
ENV KK_OFFICE_HOME=/opt/libreoffice26.8

RUN fc-cache -f >/dev/null 2>&1 || true

WORKDIR /opt/kkFileView-4.1.0
EXPOSE 8012

CMD ["java", "-Dfile.encoding=UTF-8", \
     "-Dspring.config.location=/opt/kkFileView-4.1.0/config/application.properties", \
     "-jar", "/opt/kkFileView-4.1.0/bin/kkFileView-4.1.0.jar"]
