# ---- 部署机 ----
HOST_IP=127.0.0.1
GATEWAY_PORT=9012
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379

# ---- 数据库(容器内用户 kkfileview) ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=kkfileview
MYSQL_PASSWORD=change-me-db-password
MYSQL_DB=kkfileview

# ---- 网关安全 ----
SECRET_KEY=please-change-this-secret-key
ADMIN_TOKEN=change-me-admin-token
STRICT_SIGN=0

# ---- 预览引擎 ----
# 引擎镜像。官方镜像缺 Calibri/等线等 Office 默认字体, Excel 转 PDF 排版会变形;
# 本项目用 engine/Dockerfile 构建了补字体的版本, 构建命令:
#   docker build -f engine/Dockerfile.440 -t ours:engine .
KK_IMAGE=ours:engine
KK_OFFICE_PORTS=2001,2002,2003,2004
MAX_CONCURRENT_CONVERT=4
# 水印: 文案 / 透明度(0.05=5%) / 字体 / 字号
WATERMARK_TXT="示例事业部内部资料   禁止外传"
WATERMARK_ALPHA=0.05

# 预览页品牌名：引擎自带 kkFileView 字样（如压缩包清单页标题），代理时统一换成它
BRAND_NAME=自研预览引擎
# 预览页背景改为纯白(引擎默认灰底), 0=保持原样
WHITE_BACKGROUND=1

# ---- 文件来源白名单(逗号分隔, 留空=不限制) ----
# 默认留空: 任何 http/https 文件地址都可以预览
# 如需收紧(防止预览服务被当作内网探测跳板), 填入域名或 IP, 例如: 127.0.0.1,files.corp.com
# 调用方 IP 限制不在这里配, 在「系统账号」页按 appId 设置(默认也不限制)
TRUST_HOSTS=

# ---- 允许 iframe 内嵌预览页的业务系统域名(逗号分隔, 留空=不限业务域名) ----
# 例: EMBED_ALLOWED_HOSTS=oa.corp.com,plm.corp.com,127.0.0.1
EMBED_ALLOWED_HOSTS=

# ---- Excel/CSV 表格模式(1=开启, 直接渲染行列, 不转 PDF) ----
# 关掉则 Excel 走 LibreOffice 转 PDF(会按 A4 分页, 宽表列会被截断)
SHEET_PREVIEW=0
# 表格模式(把 Excel 渲染成在线表格组件)默认关闭:
# 宽表/格式列会把组件撑到几万个格子, 浏览器直接卡死(表现为永远"渲染中")。
# 关闭后 Excel 和其它 Office 一样转 PDF, 由 pdf.js 查看器渲染, 稳定且快(小表 0.6 秒)。
# 只有确定"表小、行少、需要在线筛选"的场景才建议打开。
SHEET_EXTS=xlsx,xlsm,csv
# xlsx 直接渲染成原生 HTML 表格(全行列, 不受"打印区域"限制, 秒开)。
# 与 SHEET_PREVIEW 相互独立: 这个才是 Excel 的默认方案。
XLSX_HTML=1
# 表格渲染引擎: lucky=在线表格组件(工具栏/缩放/筛选/冻结/多sheet, 接近 Excel), simple=简易 HTML 表格
SHEET_RENDER=lucky
# ---- 表格模式"提前放弃"阈值: 命中任一即不渲染表格, 直接回退 PDF ----
# 表格组件在浏览器里同步初始化, 卡住时前端超时/降级都执行不到, 只能在服务端提前判断
SHEET_DIRECT_MAX_MB=6      # 源文件超过 6MB: 解析必慢, 直接 PDF
SHEET_MAX_PAGE_MB=1.5      # 渲染出的页面超过 1.5MB: 浏览器解析+初始化会卡
SHEET_MAX_BUILD_SEC=15     # 解析超过 15 秒: 解析都这么久, 初始化只会更慢

# ---- Office 转换: 网关直接调 LibreOffice 26.8(绕开 kkFileView 的 jodconverter) ----
# 统一使用 LibreOffice 26.8.1: 网关是唯一的 Office 转换入口, 不再保留 7.3 副本与回退。
# 自研预览引擎（内核：kkFileView）(jodconverter 4.4.6) 能直接对接 26.x；转换仍优先走网关，便于统一口径与提速。
LOCAL_CONVERT_EXTS=doc,docx,docm,dot,dotx,dotm,xls,xlsx,xlsm,xlt,xltx,xltm,csv,ppt,pptx,pptm,pot,potx,potm,pps,ppsx,ppsm,odt,ods,odp,odg,ott,ots,otp,rtf,md,markdown,wps,et,dps,vsd,vsdx
LO_CONVERT_CONC=2          # 同时进行的本地转换数(LibreOffice 吃内存, 别开太大)
# 引擎转换失败时用本地 26.8 兜底(本地优先时不会再跑一遍)
LOCAL_FALLBACK_EXTS=doc,docx,docm,dot,dotx,dotm,xls,xlsx,xlsm,xlt,xltx,xltm,ppt,pptx,pptm,pot,potx,potm,pps,ppsx,ppsm,odt,ods,odp,odg,ott,ots,otp,rtf
LO_CONVERT_TIMEOUT=180     # 单个文件转换超时(秒)
# 只保留 26.8.1 一个引擎；失败时先文字降级，不再回落 7.3。
LO_SOFFICE_LIST=/opt/libreoffice26.8/program/soffice

# ---- 首次响应预算 ----
# 接口最多同步等转码这么久，超时立刻返回 converting（带 previewUrl），
# 页面自己显示"转换中 + 已等待 N 秒"并在转好后自动切换。
# 默认 0.5：DWG 冷转 20~30 秒，接口干等越久，用户看到界面的时间越晚。
# 小文件（xlsx/docx 0.1~0.6 秒）仍会在预算内直接返回 ready。
PREVIEW_WAIT_SECONDS=0.5

# ---- Markdown：1=网关转彩色 HTML（默认）；0=LibreOffice 转 PDF（黑白稿）----
MD_HTML=1

# ---- 压缩包清单（网关自己解析，不经引擎）----
# 引擎渲染 zip 要 300~3000ms；标准库只读中央目录只要几十毫秒。
# rar/7z 解析不了，仍交给引擎。
ARCHIVE_RENDER=1
ARCHIVE_EXTS=zip,jar,war,tar,tgz

# ---- Univer 预览（只用于 Office 表格）----
# 1 = xlsx/xls 走内置 Univer 页面（默认）
# 0 = 回退到原来的 HTML 表格渲染 / pdf.js（应急）
# 幻灯片（ppt/pptx）不在其中：一律走 LibreOffice 转出的 PDF + pdf.js，
# Univer Slides 的画布宽度没扣左侧缩略图栏，会把页面右侧裁掉。
UNIVER_PREVIEW=1
UNIVER_SHEET_EXTS=xlsx,xlsm,xls

# ---- CAD 出图方式 ----
# 1 = 网关用 PDFium 把引擎转出的 PDF 渲染成位图（默认）；
#     pdf.js 渲不动 Aspose 产出的复杂图纸（444 万条线段要 4 分钟以上），
#     位图整页 6000px 只要 0.8 秒，浏览器直接显示。
# 0 = 退回引擎 pdf.js 页（仅应急，复杂图纸会长时间空白）
CAD_RASTER=1

# 3D/CAD 文本源文件（STEP/IGES/OBJ…）传输时 gzip，压缩比通常 3~6 倍
TEXT_SOURCE_EXTS=step,stp,iges,igs,brep,obj,dae,3ds,wrl,off,stl,gltf,ply,x3d,asc

# ---- CAD 类（DWG/DXF）----
# 引擎的 CAD 页面会同步做 DWG→PDF 转换，必须先转好再让浏览器进去。
CAD_EXTS=dwg,dxf,dwf,dwt,dwfx,plt,cf2
# 预览模式：pdf（默认，体积小、pdf.js 先渲染第一页）/ svg（转换快但产物极大，慎用）
# 注意：改这个要同时改 docker-compose.yml 里 kkfileview 的 KK_CAD_PREVIEW_TYPE
KK_CAD_PREVIEW_TYPE=pdf

# ---- 预览缓存有效期 ----
# 产物多久检查一次"源文件有没有变"。检查只是一次本地 stat(微秒级), 所以给得很短:
# 文件更新后, 用户下次打开(与上次间隔超过这个值)立刻就能看到新版本。
# 校验通过会把产物续期, 所以正常文件不会因此重转。
# 0 = 关闭时效检查(产物一直复用, 永不发现源文件变更)。
CACHE_TTL_MINUTES=1

# 过期后的"变更校验": 先只发 HEAD 比一下源站的 Content-Length/Last-Modified/ETag,
# 源文件没变就把产物续期(不重转), 变了才重转。
# 关掉 = 回到"过期必重转"; DWG 一次要 19~30 秒, 不建议关。
CACHE_REVALIDATE=1


# 端到端"加载耗时"统计: 预览页在首屏内容真正可见时上报, 回填这条记录的 cost_ms。
# 关掉就退回旧口径——只算 /preview/url 接口本身的耗时(DWG 会显示 0.4 秒而用户等 20 秒)。
LOAD_METRIC=1

# ---- PPT 秒开(快速内容页) ----
# 大 PPT 两阶段: 先只转前 N 页真实排版, 后台再补齐全部; 0 表示关闭, 一律整本转
PPT_PARTIAL_PAGES=15
PPT_PARTIAL_MIN=30         # 页数超过多少才启用两阶段(小 PPT 一次转完更划算)
# 老版二进制 .ppt/.dps 不是 zip, 生成内容页前要先让 LibreOffice 升级成 pptx(同步动作)。
# 超过这个体积就跳过内容页、直接显示"转换中"等待页, 避免浏览器请求长时间挂着。
# 实测 21MB/14 页 1.3 秒、46MB/119 页 8.8 秒。
LEGACY_OUTLINE_MAX_MB=60

# ---- 限流 ----
GLOBAL_QPS=120
DEFAULT_APP_QPS=60
EMP_QPS=20

# ---- 数据保留 ----
# access_log / audit_log 保留天数。审计与失败原因要能回溯半年, 默认 180。
# 后台每 6 小时分批清理超期数据; 聚合表(stat_*)长期保留, 总览"累计"不受影响。
# 设 0 = 不清理(会无限增长)。
RETENTION_DAYS=180

# ---- 服务告警推送 ----
# 告警只写进 alert_log 的话，没人盯看板就等于没有告警：
# 实测 11-04 内存涨到 9.98GB（限额 10GB）、11-06 有加载超时，都是事后翻表才发现的。
# 填上群机器人地址，触发/恢复会主动推出去。
#   企业微信：群设置 → 群机器人 → 添加 → 复制 Webhook
#   钉钉：群设置 → 智能群助手 → 添加机器人 → 自定义
# 留空 = 只记录不推送（看板「服务告警」仍可查）。
ALERT_WEBHOOK=
# wecom（默认）/ dingtalk / raw（原样 POST {"text": "..."}，接自建网关时用）
ALERT_WEBHOOK_KIND=wecom
# 同一告警的触发通知静默期（秒）。评估周期是 60 秒，不静默会每 60 秒推一次把群刷满。
# 恢复通知不受此限制。
ALERT_NOTIFY_GAP=600
